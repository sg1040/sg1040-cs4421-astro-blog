---
import Head from "../../components/Head.astro";
import Navigation from "../../components/Navigation.astro";
import Widgets from "../../components/Widgets.astro";
import { SITE_DESCRIPTION } from "../../consts";
import { getPosts } from "../../utils/posts";
import { db } from "../../lib/dynamodb";
import { QueryCommand } from "@aws-sdk/lib-dynamodb";

const { slug } = Astro.params;

const posts = getPosts("artlog");
const post = posts.find((p) => p.slug === slug);

if (!post) {
  return new Response(null, { status: 404 });
}

const { title, component: Post } = post;

// Fetch comments for this post
let comments = [];
if (slug) {
  try {
    const result = await db.send(
      new QueryCommand({
        TableName: "Comments",
        KeyConditionExpression: "postSlug = :slug",
        ExpressionAttributeValues: {
          ":slug": `/art-log/${slug}/`,
        },
      })
    );
    comments = result.Items ?? [];
  } catch (e) {
    console.error("Error fetching comments:", e);
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | Artlog`} description={SITE_DESCRIPTION} />
    <style>
      .comment-section {
        margin-top: 3rem;
        border-top: 1px solid #ccc;
        padding-top: 2rem;
      }
      .comment {
        background: #f4f4f4;
        padding: 1rem;
        margin-bottom: 1rem;
        border-radius: 4px;
      }
      .comment strong {
        display: block;
        margin-bottom: 0.5rem;
      }
      .comment p {
        margin: 0;
      }
      .comment small {
        display: block;
        margin-top: 0.5rem;
        color: #666;
      }
      .comment-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      .comment-form input,
      .comment-form textarea {
        padding: 0.5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-family: inherit;
      }
      .comment-form button {
        padding: 0.5rem 1rem;
        background-color: #333;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
      }
      .comment-form button:hover {
        background-color: #555;
      }
      .error-message {
        color: red;
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <Navigation />
    <main class="container">
      <div class="window">
        <div class="window-header">ARTLOG ENTRY</div>
        <div class="window-content">
          <Post />

          <section class="comment-section">
            <h2>Comments</h2>

            <div class="comments-list">
              {comments.length === 0 ? (
                <p>No comments yet. Be the first!</p>
              ) : (
                comments.map((comment) => (
                  <div class="comment">
                    <strong>{comment.authorName}</strong>
                    <p>{comment.content}</p>
                    <small>{new Date(comment.createdAt).toLocaleString()}</small>
                  </div>
                ))
              )}
            </div>

            <hr />

            <h3>Leave a comment</h3>
            <form id="comment-form" class="comment-form">
              <input
                name="authorName"
                maxlength="50"
                placeholder="Your name"
                required
              />
              <textarea
                name="content"
                maxlength="1000"
                placeholder="Write a comment..."
                required
                rows="4"
              ></textarea>
              <button type="submit">Post Comment</button>
              <p id="form-error" class="error-message" style="display: none;"></p>
            </form>
          </section>
        </div>
      </div>
    </main>
    <Widgets />

    <script>
      const form = document.getElementById("comment-form") as HTMLFormElement;
      const errorDisplay = document.getElementById("form-error") as HTMLParagraphElement;

      if (form) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          errorDisplay.style.display = "none";

          const formData = new FormData(form);
          const payload = {
            postSlug: window.location.pathname,
            authorName: formData.get("authorName"),
            content: formData.get("content"),
          };

          try {
            const response = await fetch("/api/comments", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(payload),
            });

            if (response.ok) {
              window.location.reload();
            } else {
              const errorData = await response.json();
              errorDisplay.textContent = errorData.error || "Something went wrong";
              errorDisplay.style.display = "block";
            }
          } catch (err) {
            errorDisplay.textContent = "Failed to submit comment. Please try again.";
            errorDisplay.style.display = "block";
          }
        });
      }
    </script>
  </body>
</html>
