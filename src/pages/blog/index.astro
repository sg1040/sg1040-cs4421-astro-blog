---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<h1>Blog</h1>

{posts.map((post) => (
    <article>
        <a href={`/blog/${post.id}/`}>
            <h2>{post.data.title}</h2>
        </a>
        <p>{post.data.description}</p>
    </article>
))}
