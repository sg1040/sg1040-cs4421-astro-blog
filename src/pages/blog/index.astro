<style>
	main {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		grid-template-areas:
			"blog box-right";
		gap: 2rem
	}

	section {
		grid-area: blog;
	}

nav {
		align-items: center;
		display: flex;
		justify-content: flex-start;
		border: 2px solid var(--header-text);
	}
	nav a {
		padding: 0.5em;
		border-bottom: 1px solid transparent;
		text-decoration: none;

	nav h2 a{
		color: var(--text-color);	
	}

	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--header-text);
	}

	ul {
		list-style-type: none;
		padding: 0;
	}

	ul h2 {
		font-family: var(--font-display);
	}

	.blog-entry {
		position: relative;
		margin: 1em 0;
		padding: 1em;
		border: 1px dashed var(--header-text);
	}

	.blog-entry > a {
		display: block;
		font-family: var(--font-ui);
	}

	

	.ascii-corner {
		position: absolute;
		padding: 0 0.15em;
		background: var(--page-bg);
		color: var(--header-text);
		font-family: monospace;
		line-height: 1;
	}

	.ascii-corner.top-left {
		top: -0.45em;
		left: -0.35em;
	}

	.ascii-corner.top-right {
		top: -0.45em;
		right: -0.35em;
	}

	.ascii-corner.bottom-left {
		bottom: -0.45em;
		left: -0.35em;
	}

	.ascii-corner.bottom-right {
		bottom: -0.45em;
		right: -0.35em;
	}

	.box-right {
		grid-area: box-right;
		justify-content: center;
		padding: 2em;
		border: 2px solid var(--header-text);
	}
</style>