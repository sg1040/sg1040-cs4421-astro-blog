---
import { getCollection, type CollectionEntry } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: allPosts
        .filter((post) => post.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const tag = Astro.params.tag;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag ? `Posts tagged: ${tag}` : 'Tag not found'}>
  {posts.length > 0 ? (
    <ul>
      {posts.map((post) => (
        <li class="blog-entry">
          <span class="ascii-corner top-left" aria-hidden="true">+</span>
          <span class="ascii-corner top-right" aria-hidden="true">+</span>
          <span class="ascii-corner bottom-left" aria-hidden="true">+</span>
          <span class="ascii-corner bottom-right" aria-hidden="true">+</span>
          <a href={`/blog/${post.id}/`}>
            <h2 class="title">{post.data.title}</h2>
          </a>
          <p class="date"><FormattedDate date={post.data.pubDate} /></p>
        </li>
      ))}
    </ul>
  ) : (
    <h1>Tag not found</h1>
  )}

</BaseLayout>

<style>
  ul {
    list-style: none;
    padding: 0;
  }

  ul h2 {
    font-family: var(--font-display);
  }

  .blog-entry {
    position: relative;
    margin: 1em 0;
    padding: 1em;
    border: 1px dashed var(--header-text);
  }

  .blog-entry > a {
    display: block;
  }

  .title {
    margin: 0;
  }

  .date {
    margin: 1em 0;
  }

  .ascii-corner {
    position: absolute;
    padding: 0 0.15em;
    background: var(--page-bg);
    color: var(--header-text);
    font-family: monospace;
    line-height: 1;
  }

  .ascii-corner.top-left {
    top: -0.45em;
    left: -0.35em;
  }

  .ascii-corner.top-right {
    top: -0.45em;
    right: -0.35em;
  }

  .ascii-corner.bottom-left {
    bottom: -0.45em;
    left: -0.35em;
  }

  .ascii-corner.bottom-right {
    bottom: -0.45em;
    right: -0.35em;
  }
</style>