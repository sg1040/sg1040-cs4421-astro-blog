---
import { Image } from "astro:assets";
import Head from "../components/Head.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Navigation from "../components/Navigation.astro";
import Widgets from "../components/Widgets.astro";

const photos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpg,jpeg,png,webp}",
);

const photoDetails: Record<
  string,
  { title: string; alt: string; year?: string }
> = {

  "photo-swans.jpg": {
    title: "Some swans",
    alt: "Profile portrait",
  },
  "photo-shannon.jpg": {
    title: "Walk by the river shannon",
    alt: "Profile portrait",
  },
  "photo-ducks.jpg": {
    title: "Ducklings having a snuggle",
    alt: "Profile portrait",
  },
  "photo-path.jpg": {
    title: "About to reach the lakes",
    alt: "Profile portrait",
  },
  "photo-leo.jpg": {
    title: "My dog Leo by the lakes",
    alt: "Profile portrait",
  },
  "photo-waterfall.jpg": {
    title: "Waterfall in devil's glen",
    alt: "Profile portrait",
  },
  "photo-waterpaint.jpg": {
    title: "Art Gallery trip! This painting (The Meeting on the Turret Stairs) is all watercolour (insane!!) They only show it for a few hours a week.",
    alt: "Profile portrait",
  },
  "photo-christ.jpg": {
    title: "Art Gallery trip! This is Caravaggio's The Taking of Christ (I think)",
    alt: "Profile portrait",
  },
  "photo-picasso.jpg": {
    title: "Pigeon sculpture by Picasso. I love pigeons",
    alt: "Profile portrait",
  },
  "photo-molly.jpg": {
    title: "Molly!! The cat that lives on my secondary school campus",
    alt: "Profile portrait",
  },
  "photo-arch.jpg": {
    title: "Sea arch in Donegal. So cool!",
    alt: "Profile portrait",
  },
  "photo-beetle.jpg": {
    title: "Beetle on da beach",
    alt: "Profile portrait",
  },
  "photo-street.jpg": {
    title: "Street in Derry. I kinda forget why I included this. Derry was cool just not this picture",
    alt: "Profile portrait",
  },
  "photo-deer.jpg": {
    title: "Deer by the beach!",
    alt: "Profile portrait",
  },
  "photo-pigeons.jpg": {
    title: "Pigeons!! My favs!",
    alt: "Profile portrait",
  },
  "photo-ben.jpg": {
    title: "Ben Bulben! My fav mountain",
    alt: "Profile portrait",
  },
  "photo-sunset.jpg": {
    title: "Sunset in Sligo. Was visiting grandparents",
    alt: "Profile portrait",
  },
  "photo-bridge.jpg": {
    title: "School Trip!! Cool bridge thing",
    alt: "Profile portrait",
  },
  "photo-montserrat.jpg": {
    title: "School Trip!! View from Montserrat monastery",
    alt: "Profile portrait",
  },
  "photo-seal.jpg": {
    title: "Big ol seal in Houth Harbour. Was there for the Ireland's Eye Swim",
    alt: "Profile portrait",
  },
};

const galleryItems = (
  await Promise.all(
    Object.entries(photoDetails).map(async ([filename, details], index) => {
      const path = Object.keys(photos).find((p) => p.endsWith(filename));

      if (!path) {
        console.warn(`Missing gallery image: ${filename}`);
        return null;
      }

      const { default: photo } = await photos[path]();

      return {
        photo,
        details,
        index,
        filename,
      };
    }),
  )
).filter(Boolean);
---

<!doctype html>
<div class = "crt-lines"></div>
<html>
  <head>
    <Head title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Navigation />

    <div id="dynamic-content" class="container">
      <div class="window">
        <div class="window-content" style="padding:0;">
          <div
            class="popup"
            style="margin:0; border:none; border-top:1px solid #333636; border-left:1px solid #333636; border-right:1px solid #101212; border-bottom:1px solid #101212;"
          >
            <div class="popup-bar">localizer.exe</div>
            <div class="popup-content localizer-banner-layout">
              <pre
                style="margin:0; font-size:8px; line-height:1.2; color:#c4c7c7; font-family:'Courier New',Courier,monospace; overflow-x:auto; max-width:100%;">                          
ooooooooo.   ooooo   ooooo   .oooooo.   ooooooooooooo   .oooooo.          .oooooo.          .o.       ooooo        ooooo        oooooooooooo ooooooooo.   oooooo   oooo 
