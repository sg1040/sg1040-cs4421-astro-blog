---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class = "intro">

				<div class = "intro-welcome">

					<h1>Welcome!</h1>

				</div>

				<div class = "intro-left"> 

					<p>
						This is my blog that I made with <a href="https://astro.build/">Astro</a>
					</p>

				</div>

				<div class = "intro-right"> 

					<p>
						This is what I'll put on the right side
					</p>

				</div>

				

			</div>
			
			<div>
				class

				<iframe
					src="https://js-dos.com/DOOM/"
					width="640"
					height="400"
					allow="autoplay; fullscreen; keyboard"
					sandbox="allow-scripts allow-same-origin"
				>
				</iframe>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>

	h1 {
		font-family: var(--font-display);
		font-size: 10rem;
	}

	.intro {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-areas:
			"welcome welcome"
			"left right";
		gap: 2rem;
		margin: 2em;
		padding: 2em;
		background: darkblue;
	}
	
	.intro-welcome {
		
		grid-area: welcome;
		text-align: center;
		background: lightblue;
		padding: 2em;
	}

	.intro-left {
		grid-area: left;
		background: lightblue;
		padding: 2em;
	}

	.intro-right {
		grid-area: right;
		background: lightblue;
		padding: 2em;
	}
</style>
