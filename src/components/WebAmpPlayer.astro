<button id="music-toggle" type="button">winamp.exe</button>

<div id="webamp-overlay" hidden>
  <div id="webamp-container"></div>
</div>

<script>
  let webamp;
  let isOpen = false;

  const button = document.getElementById("music-toggle");
  const container = document.getElementById("webamp-container");
  const overlay = document.getElementById("webamp-overlay");

  if (!button || !container || !overlay) {
    throw new Error("Webamp button or container is missing");
  }

  document.body.append(overlay);

  button.addEventListener("click", async () => {
    if (!webamp) {
      const { default: Webamp } = await import("webamp");

      webamp = new Webamp({
        initialTracks: [
          {
            metaData: {
              artist: "DOOM - Bobby Prince",
              title: "E1M1 - At Doom's Gate",
            },
            url: "/music/E1M1 - At Doom's Gate.mp3",
          },

          {
            metaData: {
              artist: "DOOM - Bobby Prince",
              title: "E1M4 - Kitchen Ace (And Taking Names)",
            },
            url: "/music/E1M4 - Kitchen Ace (And Taking Names).mp3",
          },

          {
            metaData: {
              artist: "DOOM - Bobby Prince",
              title: "E2M1 - I Sawed Te Demons",
            },
            url: "/music/E2M1 - I Sawed The Demons.mp3",
          },


          {
            metaData: {
              artist: "Dark Souls - Yuka Kitamura",
              title: "Firelink Shrine",
            },
            url: "/music/Firelink Shrine.mp3",
          },

          {
            metaData: {
              artist: "Disco Elysium - Sea Power",
              title: "Instrument Of Surrender",
            },
            url: "/music/Instrument Of Surrender.mp3",
          },

          {
            metaData: {
              artist: "Persona 3 - SHoji Meguro",
              title: "Iwatodai Dorm -Reload-",
            },
            url: "/music/Iwatodai Dorm -Reload-.mp3",
          },

          {
            metaData: {
              artist: "Nintedno 3DS - Kazumi Totaka",
              title: "Mii Maker - Main Theme",
            },
            url: "/music/Mii Maker - Main Theme.mp3",
          },

          {
            metaData: {
              artist: "Minecraft - C418",
              title: "Moog City",
            },
            url: "/music/Moog City.mp3",
          },

          {
            metaData: {
              artist: "Tweaker",
              title: "Doom 3 Theme",
            },
            url: "/music/Music Credits.mp3",
          },

          {
            metaData: {
              artist: "Sony",
              title: "PS3 Startup",
            },
            url: "/music/PS3 Coldboot Multi.mp3",
          },

          {
            metaData: {
              artist: "Signalis - 1000 Eyes",
              title: "Train Ride",
            },
            url: "/music/Train Ride.mp3",
          },


        ],

        initialSkin: {
          url: "/The_CATUBI.wsz",
        },

      });

      overlay.hidden = false;
      isOpen = true;
      await webamp.renderInto(container);
      return;
    }

    isOpen = !isOpen;
    overlay.hidden = !isOpen;
  });
</script>

<style>
  #music-toggle {
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: 0.5em;
    border: none;
    background: none;
    font-size: 1rem;
    font-family: var(--font-ui);
    color: var(--header-text);
    text-align: left;
    cursor: pointer;
  }

  #music-toggle:hover {
    background: var(--header-text);
    color: var(--header-bg);
  }

  #webamp-container {
    position: relative;
    width: 100%;
    height: 100%;
  }

  #webamp-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    pointer-events: none;
  }
</style>

<style is:global>
  #webamp {
    pointer-events: auto;
  }
</style>