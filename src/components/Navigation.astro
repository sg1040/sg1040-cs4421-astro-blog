<style>
  
.ticker {
    background: var(--grey-0);
    overflow: hidden;
    padding: 4px 0;
    margin: 4px 0;
    border-top: 5px solid var(--grey-50);
    border-left: 5px solid var(--grey-50);
    border-right: 5px solid var(--grey-400);
    border-bottom: 5px solid var(--grey-400);
}

.ticker-track {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding-left: 100%;
    animation: ticker-move 60s linear infinite;
}

.ticker-track img {
    height: 300px;
    width: auto;
    image-rendering: pixelated;
}

.ticker-text {
    font-size: 18px;
    font-weight: normal;
    white-space: nowrap;
    line-height: 1;
}

.ticker-about .ticker-track {
    align-items: center;
}

.ticker-about .ticker-track img {
    width: auto;
    height: 200px;
    image-rendering: pixelated;
}

.ticker-about2 .ticker-track {
    align-items: center;
}

.ticker-about2 .ticker-track img {
    width: auto;
    height: auto;
    max-height: 200px;
    image-rendering: pixelated;
}

@keyframes ticker-move {
    from {
        transform: translateX(0);
    }

    to {
        transform: translateX(-100%);
    }
}

</style>
