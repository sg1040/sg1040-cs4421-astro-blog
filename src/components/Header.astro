---
import { SITE_TITLE } from "../consts";
import HeaderLink from "./HeaderLink.astro";
import WebAmpPlayer from "./WebAmpPlayer.astro";
---

<header>
	<nav>
		<div class="title">
			<h2><a href="/"> SG </a></h2>
		</div>

		<div class="internal-links">
			<div class="dropdown">
				<button
					class="dropbtn"
					aria-expanded="false"
					aria-controls="fileDropdown"
				>
					File
				</button>
				<div class="dropdown-content" id="fileDropdown">
					<a href="/">home.html</a>
					<a href="/blog">blog.html</a>
					<a href="/gallery">gallery.html</a>


				</div>
			</div>

			<div class="dropdown">
				<button
					class="dropbtn"
					aria-expanded="false"
					aria-controls="discDropdown"
				>
					Disc
				</button>
				<div class="dropdown-content" id="discDropdown">
					<p>doom.exe</p>
					
				</div>
			</div>

			<div class="dropdown">
				<button
					class="dropbtn"
					aria-expanded="false"
					aria-controls="systemDropdown"
				>
					System
				</button>
				<div class="dropdown-content" id="systemDropdown">
					<WebAmpPlayer />
				</div>
			</div>

			
		</div>
		<div class="social-links">
			<a href="https://github.com/sg1040" target="_blank">
				<span class="sr-only">Go to Susie's Github</span>
				<svg
					viewBox="0 0 16 16"
					aria-hidden="true"
					width="32"
					height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<span class="header-bars" aria-hidden="true"></span>
		</div>
		<div>
			<!--/ThemeIcon -->
		</div>
	</nav>
</header>

<style>
	header {
		font-family: var(--font-display);
		margin: 0;
		padding: 0.5em;
		background: var(--header-bg);
		color: var(--header-text);
		border: 2px solid var(--header-text);
	}

	h2 {
		padding: 0.5em;
		margin: 0;
		font-size: 1em;
		color: var(--text-color);
	}

	h2 a,
	h2 a.active {
		font-family: var(--font-display);
		text-decoration: none;
		font-size: 2rem;
		color: var(--text-color);
	}

	nav {
		align-items: center;
		display: flex;
		justify-content: flex-start;
	}

	nav a {
		padding: 0.5em;
		border-bottom: 1px solid transparent;
		text-decoration: none;
		color: var(--text-color);
	}

	nav a.active {
		border-bottom-color: var(--header-text);
	}

	

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.dropdown {
		position: relative;
		display: flex;
		align-items: center;
	}

	.dropbtn {
		position: relative;
		background-color: var(--page-bg);
		border: none;
		padding: 0.5em 1em;
		font-size: 1rem;
		font-family: var(--font-ui);
		color: var(--header-text);
		cursor: pointer;
		border-bottom: 1px solid transparent;
	}

	.dropbtn::before,
	.dropbtn::after {
		position: absolute;
		opacity: 0;
	}

	.dropbtn::before {
		content: "[";
		left: 0.3em;
	}

	.dropbtn::after {
		content: "]";
		right: 0.3em;
	}

	.dropbtn:hover::before,
	.dropbtn:hover::after,
	.dropbtn:focus-visible::before,
	.dropbtn:focus-visible::after,
	.dropbtn[aria-expanded="true"]::before,
	.dropbtn[aria-expanded="true"]::after {
		opacity: 1;
	}

	.dropdown-content {
		display: none;
		position: absolute;
		top: calc(100% + 1.15rem);
		left: 0;
		z-index: 100;
		min-width: 12rem;
		background: var(--header-bg);
		border: 2px solid var(--header-text);
	}

	.dropdown-content.show {
		display: block;
	}

	.dropdown-content a {
		display: block;
		padding: 0.5em;
		font-size: 0.5rem;
		font-family: var(--font-ui);
		color: var(--header-text);
		text-decoration: none;
	}

	.dropdown-content a:hover {
		background: var(--header-text);
		color: var(--header-bg);
	}

	.dropdown-content p {
		display: block;
		margin: 0;
		padding: 0.5em;
		font-size: 1rem;
		font-family: var(--font-ui);
		color: var(--header-text);
	}

	.internal-links a {
		position: relative;
		align-items: center;
		font-size: 1rem;
		font-family: var(--font-ui);
	}

	.social-links {
		flex: 1;
		min-width: 0;
		align-items: center;
		display: flex;
	}

	.social-links a {
		align-items: center;
		display: flex;
	}

	.svg {
		padding: 0.5em;
	}

	.header-bars {
		flex: 1;
		min-width: 0;
		height: 1em;
		background: repeating-linear-gradient(
			to right,
			transparent 0 8px,
			var(--header-text) 8px 10px,
			transparent 10px 16px
		);
	}

	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>

<script>
	const buttons = document.querySelectorAll(".dropbtn");

	buttons.forEach((button) => {
		const dropdown = document.getElementById(
			button.getAttribute("aria-controls"),
		);

		button.addEventListener("click", () => {
			const isOpen = dropdown.classList.toggle("show");
			button.setAttribute("aria-expanded", String(isOpen));
		});
	});

	document.addEventListener("click", (event) => {
		buttons.forEach((button) => {
			const dropdown = document.getElementById(
				button.getAttribute("aria-controls"),
			);

			if (
				!button.contains(event.target) &&
				!dropdown.contains(event.target)
			) {
				dropdown.classList.remove("show");
				button.setAttribute("aria-expanded", "false");
			}
		});
	});
</script>
