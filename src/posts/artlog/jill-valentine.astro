---
export const title = "Jill Valentine Portrait";
export const date = "2026-09-12";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { Image } from "astro:assets";
import jillValentine from "../../assets/gallery/art-jillvalentine.png";
---

<BlogLayout
  title={title}
  date={date}
>
  <p>
    I drew this while trying to adjust to Krita. It's just different enough from Clip Studio to be a pain.
  </p>

  <Image
    src={jillValentine}
    alt="Jill Valentine portrait"
    width={600}
    height={600}
    style="width: 100%; max-width: 600px; height: auto;"
  />

  <p>
    She is the happy smiler. Testing to see if deployment works.
  </p>
</BlogLayout>